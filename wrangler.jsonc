{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-31",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "thabet-portfolio",
	"account_id": "e095867da83877c667d0817a1596c5a9",
	"workers_dev": true,
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAEktppIf2m0GrFD7",
		"GITHUB_OWNER": "thabet-righi",
		"GITHUB_REPO": "thabet-portfolio",
		"GITHUB_BRANCH": "main"
	},
	"ratelimits": [
		{
			"name": "CONTACT_RATE_LIMITER",
			"namespace_id": "2001",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "ADMIN_RATE_LIMITER",
			"namespace_id": "2002",
			"simple": {
				"limit": 60,
				"period": 60
			}
		},
		{
			"name": "ADMIN_LOGIN_RATE_LIMITER",
			"namespace_id": "2003",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	"send_email": [
		{
			"name": "EMAIL",
			"destination_address": "righithabt@gmail.com",
			"allowed_sender_addresses": ["contact@thabetrighi.com"]
		}
	],
	"routes": [
		{
			"pattern": "thabetrighi.com",
			"custom_domain": true
		},
		{
			"pattern": "www.thabetrighi.com",
			"custom_domain": true
		}
	]
}