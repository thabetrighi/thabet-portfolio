---
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import Reveal from '../ui/Reveal.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const items = [...t.techMarquee.items, ...t.techMarquee.items];
---

<section class="border-t border-border overflow-hidden dark:border-border-dark">
  <div class="mx-auto max-w-wide px-5 py-12 md:px-8 md:py-16">
    <Reveal>
      <p class="section-label mb-8 text-center">{t.techMarquee.title}</p>
    </Reveal>
  </div>
  <div class="relative" aria-hidden="true">
    <div class="pointer-events-none absolute inset-y-0 start-0 z-10 w-20 bg-gradient-to-r from-paper to-transparent dark:from-paper-dark"></div>
    <div class="pointer-events-none absolute inset-y-0 end-0 z-10 w-20 bg-gradient-to-l from-paper to-transparent dark:from-paper-dark"></div>
    <div class="marquee-track gap-8 px-4">
      {items.map((tech) => (
        <span class="shrink-0 font-mono text-sm uppercase tracking-widest text-ink-muted/60 dark:text-ink-muted-dark/60">
          {tech}
        </span>
      ))}
    </div>
  </div>
</section>
