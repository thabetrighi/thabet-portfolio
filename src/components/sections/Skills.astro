---
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { getSkills } from '../../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const skillAreas = getSkills(locale);
---

<section class="border-t border-border dark:border-border-dark">
  <div class="mx-auto max-w-wide px-5 py-16 md:px-8 md:py-20">
    <h2 class="section-label mb-12">{t.skills.title}</h2>
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {skillAreas.map((area) => (
        <div>
          <h3 class="mb-4 font-mono text-xs uppercase tracking-wider text-ink dark:text-ink-dark">{area.name}</h3>
          <ul class="space-y-2">
            {area.items.map((item) => (
              <li class="text-sm text-ink-secondary dark:text-ink-secondary-dark">{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
