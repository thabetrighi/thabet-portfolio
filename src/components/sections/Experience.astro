---
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { getExperience } from '../../lib/content';
import Reveal from '../ui/Reveal.astro';

interface Props {
  locale: Locale;
  limit?: number;
}

const { locale, limit } = Astro.props;
const t = useTranslations(locale);
const experiences = getExperience(locale).slice(0, limit ?? undefined);
const presentLabel = t.experience.present;
---

<section class="border-t border-border dark:border-border-dark">
  <div class="mx-auto max-w-wide px-5 py-16 md:px-8 md:py-24">
    <Reveal>
      <h2 class="section-label mb-4">{t.experience.title}</h2>
      <p class="mb-12 max-w-2xl text-ink-secondary dark:text-ink-secondary-dark">{t.experience.subtitle}</p>
    </Reveal>

    <ol class="space-y-10">
      {experiences.map((exp, i) => (
        <Reveal delay={i * 80}>
          <li class="experience-card overflow-hidden border border-border bg-surface/40 dark:border-border-dark dark:bg-surface-dark/20">
            <div class="grid gap-0 md:grid-cols-[220px_1fr]">
              <div class="border-b border-border bg-surface/60 px-6 py-6 dark:border-border-dark dark:bg-surface-dark/40 md:border-b-0 md:border-e">
                <p class="font-mono text-xs uppercase tracking-wider text-ink-muted dark:text-ink-muted-dark">
                  {exp.startDate}
                  <span class="mx-1.5 text-accent dark:text-accent-dark" aria-hidden="true">—</span>
                  {exp.endDate || presentLabel}
                </p>
                <p class="mt-3 font-mono text-xs text-ink-muted dark:text-ink-muted-dark">{exp.location}</p>
                <p class="mt-6 font-display text-lg leading-snug">{exp.company}</p>
              </div>

              <div class="px-6 py-6 md:px-8 md:py-8">
                <h3 class="font-display text-2xl tracking-tight">{exp.position}</h3>
                <p class="mt-4 max-w-3xl leading-relaxed text-ink-secondary dark:text-ink-secondary-dark">
                  {exp.description}
                </p>

                {exp.highlights.length > 0 && (
                  <div class="mt-8">
                    <h4 class="mb-4 font-mono text-xs uppercase tracking-wider text-ink-muted dark:text-ink-muted-dark">
                      {t.experience.highlights}
                    </h4>
                    <ul class="grid gap-3 sm:grid-cols-2">
                      {exp.highlights.map((item) => (
                        <li class="flex gap-3 text-sm leading-relaxed text-ink-secondary dark:text-ink-secondary-dark">
                          <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent dark:bg-accent-dark" aria-hidden="true"></span>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {exp.platformTags.length > 0 && (
                  <div class="mt-8">
                    <h4 class="mb-3 font-mono text-xs uppercase tracking-wider text-ink-muted dark:text-ink-muted-dark">
                      {t.experience.platforms}
                    </h4>
                    <div class="flex flex-wrap gap-2">
                      {exp.platformTags.map((tag) => (
                        <span class="tag tag-muted">{tag}</span>
                      ))}
                    </div>
                  </div>
                )}

                <div class="mt-8 border-t border-border pt-6 dark:border-border-dark">
                  <h4 class="mb-3 font-mono text-xs uppercase tracking-wider text-ink-muted dark:text-ink-muted-dark">
                    {t.experience.techStack}
                  </h4>
                  <div class="flex flex-wrap gap-2">
                    {exp.technologies.map((tech) => (
                      <span class="tag">{tech}</span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </li>
        </Reveal>
      ))}
    </ol>
  </div>
</section>
