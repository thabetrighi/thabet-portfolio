---
import type { Locale } from '../../i18n/config';
import { getLocalizedPath } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { getAbout } from '../../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const about = getAbout(locale);
---

<section class="border-t border-border dark:border-border-dark">
  <div class="mx-auto max-w-wide px-5 py-16 md:px-8 md:py-20">
    <div class="grid gap-10 md:grid-cols-[200px_1fr]">
      <h2 class="section-label md:pt-1">{t.about.title}</h2>
      <div class="max-w-2xl">
        <p class="text-lg leading-relaxed text-ink-secondary dark:text-ink-secondary-dark">
          {about.summary}
        </p>
        <a
          href={getLocalizedPath(locale, 'about')}
          class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-accent link-underline dark:text-accent-dark no-underline"
        >
          {t.about.more}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
