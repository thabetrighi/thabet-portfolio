---
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { site } from '../lib/site';
import { CONTACT_LIMITS } from '../lib/security';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const fieldClass =
  'w-full border border-border bg-surface px-4 py-3 text-sm transition-colors focus:border-accent focus:outline-none dark:border-border-dark dark:bg-surface-dark dark:focus:border-accent-dark';
const fieldErrorClass =
  'border-accent focus:border-accent dark:border-accent-dark dark:focus:border-accent-dark';
---

<form id="contact-form" class="space-y-6" novalidate>
  <div>
    <label for="name" class="mb-2 block text-sm font-medium">{t.contact.name}</label>
    <input
      type="text"
      id="name"
      name="name"
      required
      maxlength={CONTACT_LIMITS.name}
      autocomplete="name"
      class={fieldClass}
      aria-describedby="name-error"
    />
    <p id="name-error" class="mt-1 hidden text-sm text-accent dark:text-accent-dark" role="alert"></p>
  </div>
  <div>
    <label for="email" class="mb-2 block text-sm font-medium">{t.contact.email}</label>
    <input
      type="email"
      id="email"
      name="email"
      required
      maxlength={CONTACT_LIMITS.email}
      autocomplete="email"
      class={fieldClass}
      aria-describedby="email-error"
    />
    <p id="email-error" class="mt-1 hidden text-sm text-accent dark:text-accent-dark" role="alert"></p>
  </div>
  <div>
    <label for="message" class="mb-2 block text-sm font-medium">{t.contact.message}</label>
    <textarea
      id="message"
      name="message"
      required
      rows="6"
      maxlength={CONTACT_LIMITS.message}
      class={`${fieldClass} resize-y`}
      aria-describedby="message-error"
    ></textarea>
    <p id="message-error" class="mt-1 hidden text-sm text-accent dark:text-accent-dark" role="alert"></p>
  </div>

  <!-- Honeypot for bots -->
  <div class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
    <label for="website">Website</label>
    <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
  </div>

  {site.turnstileSiteKey && (
    <div class="cf-turnstile" data-sitekey={site.turnstileSiteKey}></div>
  )}

  <div id="form-status" class="hidden text-sm" role="status" aria-live="polite"></div>

  <button type="submit" class="btn btn-primary" id="submit-btn">
    {t.contact.send}
  </button>
</form>

<script define:vars={{
  successMsg: t.contact.success,
  errorMsg: t.contact.error,
  rateLimitedMsg: t.contact.rateLimited,
  captchaFailedMsg: t.contact.captchaFailed,
  sendingMsg: t.contact.sending,
  sendLabel: t.contact.send,
  nameRequiredMsg: t.contact.nameRequired,
  emailRequiredMsg: t.contact.emailRequired,
  messageRequiredMsg: t.contact.messageRequired,
  invalidEmailMsg: t.contact.invalidEmail,
  turnstileSiteKey: site.turnstileSiteKey,
  fieldErrorClass,
}}>
  const EMAIL_REGEX = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function loadTurnstile() {
    if (!turnstileSiteKey) return;
    if (document.querySelector('script[src*="turnstile"]')) return;
    const script = document.createElement('script');
    script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
    script.async = true;
    script.defer = true;
    document.head.appendChild(script);
  }

  function resolveErrorMessage(status, payload) {
    if (status === 429) return rateLimitedMsg;
    if (payload?.error === 'captcha_failed' || payload?.error === 'captcha_required') {
      return captchaFailedMsg;
    }
    return errorMsg;
  }

  function clearFieldError(fieldId) {
    const field = document.getElementById(fieldId);
    const error = document.getElementById(`${fieldId}-error`);
    if (!field || !error) return;
    field.classList.remove(...fieldErrorClass.split(' '));
    error.textContent = '';
    error.classList.add('hidden');
    field.removeAttribute('aria-invalid');
  }

  function setFieldError(fieldId, message) {
    const field = document.getElementById(fieldId);
    const error = document.getElementById(`${fieldId}-error`);
    if (!field || !error) return;
    field.classList.add(...fieldErrorClass.split(' '));
    error.textContent = message;
    error.classList.remove('hidden');
    field.setAttribute('aria-invalid', 'true');
  }

  function clearAllFieldErrors() {
    clearFieldError('name');
    clearFieldError('email');
    clearFieldError('message');
  }

  function validateForm(form) {
    clearAllFieldErrors();

    const name = String(form.elements.namedItem('name')?.value ?? '').trim();
    const email = String(form.elements.namedItem('email')?.value ?? '').trim();
    const message = String(form.elements.namedItem('message')?.value ?? '').trim();

    let isValid = true;
    let firstInvalidField = null;

    if (!name) {
      setFieldError('name', nameRequiredMsg);
      firstInvalidField ??= 'name';
      isValid = false;
    }

    if (!email) {
      setFieldError('email', emailRequiredMsg);
      firstInvalidField ??= 'email';
      isValid = false;
    } else if (!EMAIL_REGEX.test(email)) {
      setFieldError('email', invalidEmailMsg);
      firstInvalidField ??= 'email';
      isValid = false;
    }

    if (!message) {
      setFieldError('message', messageRequiredMsg);
      firstInvalidField ??= 'message';
      isValid = false;
    }

    if (firstInvalidField) {
      document.getElementById(firstInvalidField)?.focus();
    }

    return isValid;
  }

  function setupContactForm() {
    loadTurnstile();
    const form = document.getElementById('contact-form');
    const status = document.getElementById('form-status');
    const submitBtn = document.getElementById('submit-btn');
    if (!form || !status || !submitBtn) return;

    for (const fieldId of ['name', 'email', 'message']) {
      const field = document.getElementById(fieldId);
      field?.addEventListener('input', () => clearFieldError(fieldId));
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.classList.add('hidden');

      if (!validateForm(form)) {
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = sendingMsg;

      const formData = new FormData(form);
      const turnstileResponse = form.querySelector('[name="cf-turnstile-response"]')?.value;

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: formData.get('name'),
            email: formData.get('email'),
            message: formData.get('message'),
            website: formData.get('website'),
            'cf-turnstile-response': turnstileResponse,
          }),
        });

        const payload = await res.json().catch(() => ({}));
        status.classList.remove('hidden');

        if (res.ok) {
          status.textContent = successMsg;
          status.className = 'text-sm text-green-600 dark:text-green-400';
          form.reset();
          clearAllFieldErrors();
          if (window.turnstile) window.turnstile.reset();
        } else {
          status.textContent = resolveErrorMessage(res.status, payload);
          status.className = 'text-sm text-accent dark:text-accent-dark';
          if (window.turnstile) window.turnstile.reset();
        }
      } catch {
        status.classList.remove('hidden');
        status.textContent = errorMsg;
        status.className = 'text-sm text-accent dark:text-accent-dark';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = sendLabel;
      }
    });
  }

  setupContactForm();
  document.addEventListener('astro:after-swap', setupContactForm);
</script>
