---
import { locales, localeNames, getLocalizedPath, type Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
  currentPath?: string;
  compact?: boolean;
}

const { locale, currentPath = '', compact = false } = Astro.props;
---

<div class="relative" data-lang-switcher>
  <button
    type="button"
    class:list={['header-control-btn', compact ? 'header-control-btn--icon' : 'header-control-btn--lang']}
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label={`Language: ${localeNames[locale]}`}
    data-lang-trigger
  >
    <svg class="h-4 w-4 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5a17.92 17.92 0 0 1-8.716-2.247m0 0A8.966 8.966 0 0 1 3 12c0-1.264.26-2.467.732-3.56" />
    </svg>
    {!compact && (
      <>
        <span class="leading-none">{locale}</span>
        <svg class="h-3 w-3 shrink-0 opacity-60" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
        </svg>
      </>
    )}
  </button>
  <ul
    class="absolute end-0 top-full z-50 mt-1.5 hidden min-w-[9rem] border border-border bg-surface py-1 shadow-md dark:border-border-dark dark:bg-surface-dark"
    role="listbox"
    data-lang-menu
  >
    {locales.map((loc) => (
      <li role="option" aria-selected={loc === locale}>
        <a
          href={getLocalizedPath(loc, currentPath)}
          class:list={[
            'flex items-center gap-2 px-4 py-2.5 text-sm no-underline transition-colors',
            loc === locale
              ? 'text-accent dark:text-accent-dark font-medium'
              : 'text-ink-secondary hover:text-ink dark:text-ink-secondary-dark dark:hover:text-ink-dark',
          ]}
          data-locale={loc}
        >
          <span class="font-mono text-[10px] uppercase tracking-wider opacity-60">{loc}</span>
          {localeNames[loc]}
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  function setupLangSwitcher() {
    document.querySelectorAll('[data-lang-switcher]').forEach((wrapper) => {
      const trigger = wrapper.querySelector('[data-lang-trigger]') as HTMLButtonElement;
      const menu = wrapper.querySelector('[data-lang-menu]') as HTMLUListElement;
      if (!trigger || !menu) return;
      if (trigger.dataset.bound) return;
      trigger.dataset.bound = 'true';

      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = !menu.classList.contains('hidden');
        menu.classList.toggle('hidden', isOpen);
        trigger.setAttribute('aria-expanded', String(!isOpen));
      });

      menu.querySelectorAll('a[data-locale]').forEach((link) => {
        link.addEventListener('click', () => {
          const loc = link.getAttribute('data-locale');
          if (loc) {
            document.cookie = `preferred-locale=${loc};path=/;max-age=${60 * 60 * 24 * 365};SameSite=Lax`;
          }
        });
      });
    });

    if (!document.documentElement.dataset.langClickBound) {
      document.documentElement.dataset.langClickBound = 'true';
      document.addEventListener('click', () => {
        document.querySelectorAll('[data-lang-menu]').forEach((menu) => {
          menu.classList.add('hidden');
        });
        document.querySelectorAll('[data-lang-trigger]').forEach((btn) => {
          btn.setAttribute('aria-expanded', 'false');
        });
      });
    }
  }

  setupLangSwitcher();
  document.addEventListener('astro:after-swap', setupLangSwitcher);
</script>
