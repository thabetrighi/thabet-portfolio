---
import { socialLinks, socialLabels } from '../lib/social';
import SocialIcon from './icons/SocialIcon.astro';

interface Props {
  size?: 'sm' | 'md' | 'lg';
  showLabels?: boolean;
  class?: string;
}

const { size = 'md', showLabels = false, class: className = '' } = Astro.props;

const iconSize = size === 'sm' ? 'h-4 w-4' : size === 'lg' ? 'h-5 w-5' : 'h-[18px] w-[18px]';
const btnSize = size === 'sm' ? 'social-link-sm' : size === 'lg' ? 'social-link-lg' : 'social-link-md';
---

{socialLinks.length > 0 && (
  <div class:list={['flex flex-wrap items-center gap-2', className]} role="list">
    {socialLinks.map((link) => (
      <a
        href={link.url}
        class:list={['social-link', btnSize]}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={socialLabels[link.platform]}
        title={socialLabels[link.platform]}
        role="listitem"
      >
        <SocialIcon platform={link.platform} class={iconSize} />
        {showLabels && <span class="text-sm">{socialLabels[link.platform]}</span>}
      </a>
    ))}
  </div>
)}
