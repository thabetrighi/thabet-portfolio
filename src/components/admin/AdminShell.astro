---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { adminUi } from '../../lib/admin/ui/strings';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const t = adminUi.nav;
const path = Astro.url.pathname;

const links = [
  { href: '/admin', label: t.dashboard, section: 'main', icon: 'dashboard' },
  { href: '/admin/articles', label: t.articles, section: 'content', icon: 'articles' },
  { href: '/admin/projects', label: t.projects, section: 'content', icon: 'projects' },
  { href: '/admin/settings/site', label: t.site, section: 'settings', icon: 'settings' },
  { href: '/admin/settings/social', label: t.social, section: 'settings', icon: 'social' },
  { href: '/admin/profile', label: t.profile, section: 'settings', icon: 'profile' },
  { href: '/admin/deploy', label: t.deploy, section: 'system', icon: 'deploy' },
];

function isActive(href: string) {
  if (href === '/admin') return path === '/admin' || path === '/admin/';
  return path === href || path.startsWith(`${href}/`);
}

const pageTitle = title || links.find((l) => isActive(l.href))?.label || adminUi.brand;
const sections = [
  { id: 'main', label: adminUi.sections.main },
  { id: 'content', label: adminUi.sections.content },
  { id: 'settings', label: adminUi.sections.settings },
  { id: 'system', label: adminUi.sections.system },
];
---

<div class="admin-app">
  <div class="admin-shell">
    <aside class="admin-sidebar" id="admin-sidebar">
      <div class="admin-brand">
        <div class="admin-brand-mark">T</div>
        <div class="admin-brand-text">
          <strong>{adminUi.brand}</strong>
          <span>Thabet Portfolio CMS</span>
        </div>
      </div>

      <nav class="admin-nav">
        {sections.map((section) => (
          <>
            <div class="admin-nav-section">{section.label}</div>
            {links.filter((l) => l.section === section.id).map((link) => (
              <a href={link.href} class:list={{ 'is-active': isActive(link.href) }}>
                {link.icon === 'dashboard' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1v-9.5Z"/></svg>
                )}
                {link.icon === 'articles' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 4h9l3 3v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z"/><path d="M15 4v4h4M8 12h8M8 16h8"/></svg>
                )}
                {link.icon === 'projects' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="7" height="7" rx="1"/><rect x="14" y="4" width="7" height="7" rx="1"/><rect x="3" y="15" width="7" height="7" rx="1"/><rect x="14" y="15" width="7" height="7" rx="1"/></svg>
                )}
                {link.icon === 'settings' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                )}
                {link.icon === 'social' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M8 12a4 4 0 0 0 8 0"/><path d="M9 16.5c.7.5 1.6.8 2.5.8s1.8-.3 2.5-.8"/></svg>
                )}
                {link.icon === 'profile' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M5 20a7 7 0 0 1 14 0"/></svg>
                )}
                {link.icon === 'deploy' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 4 9v12h16V9l-8-6Z"/><path d="M12 12v9M8.5 15.5h7"/></svg>
                )}
                {link.label}
              </a>
            ))}
          </>
        ))}
      </nav>

      <div class="admin-sidebar-footer">
        <a href="https://thabetrighi.com" class="admin-btn admin-btn-ghost admin-btn-sm" target="_blank" rel="noopener">{t.viewSite}</a>
        <button type="button" class="admin-btn admin-btn-ghost admin-btn-sm" id="admin-logout-btn">{t.logout}</button>
      </div>
    </aside>

    <div class="admin-content-wrap">
      <header class="admin-navbar">
        <div class="admin-navbar-start">
          <button type="button" class="admin-icon-btn" id="admin-menu-toggle" aria-label="القائمة">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
          <div class="admin-breadcrumb">
            <span>{adminUi.brand}</span>
            <span>/</span>
            <strong>{pageTitle}</strong>
          </div>
        </div>
        <div class="admin-navbar-end">
          <button type="button" class="admin-icon-btn" data-theme-toggle aria-label="تبديل الوضع">
            <svg class="theme-icon-dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
          </button>
          <div class="admin-user-chip">
            <span class="admin-user-avatar">T</span>
            <span>Admin</span>
          </div>
        </div>
      </header>
      <main class="admin-main">
        <slot />
      </main>
    </div>
  </div>
  <div class="admin-overlay" id="admin-overlay"></div>
</div>

<script>
  document.getElementById('admin-logout-btn')?.addEventListener('click', async () => {
    await fetch('/api/admin/auth/logout', { method: 'POST', credentials: 'same-origin' });
    window.location.href = '/admin/login';
  });
</script>
