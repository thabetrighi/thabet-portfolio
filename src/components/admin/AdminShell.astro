---
import { adminUi } from '../../lib/admin/ui/strings';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname;

const links = [
  { href: '/admin', label: adminUi.nav.dashboard, section: 'main', icon: 'dashboard' },
  { href: '/admin/articles', label: adminUi.nav.articles, section: 'content', icon: 'articles' },
  { href: '/admin/projects', label: adminUi.nav.projects, section: 'content', icon: 'projects' },
  { href: '/admin/settings/site', label: adminUi.nav.site, section: 'settings', icon: 'settings' },
  { href: '/admin/settings/social', label: adminUi.nav.social, section: 'settings', icon: 'social' },
  { href: '/admin/profile', label: adminUi.nav.profile, section: 'settings', icon: 'profile' },
  { href: '/admin/deploy', label: adminUi.nav.deploy, section: 'system', icon: 'deploy' },
];

function isActive(href: string) {
  if (href === '/admin') return path === '/admin' || path === '/admin/';
  return path === href || path.startsWith(`${href}/`);
}

const pageTitle = title || links.find((l) => isActive(l.href))?.label || adminUi.brand;
const sections = [
  { id: 'main', label: adminUi.sections.main },
  { id: 'content', label: adminUi.sections.content },
  { id: 'settings', label: adminUi.sections.settings },
  { id: 'system', label: adminUi.sections.system },
];
---

<div class="adm adm-layout">
  <aside class="adm-sidebar" id="admin-sidebar">
    <div class="adm-brand">
      <div class="adm-brand-icon">T</div>
      <div class="adm-brand-text">
        <strong>{adminUi.brand}</strong>
        <span>Portfolio CMS</span>
      </div>
    </div>

    <nav>
      {sections.map((section) => (
        <>
          <div class="adm-nav-label">{section.label}</div>
          {links.filter((l) => l.section === section.id).map((link) => (
            <a href={link.href} class:list={['adm-nav-link', { 'is-active': isActive(link.href) }]}>
              {link.icon === 'dashboard' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1v-9.5Z"/></svg>
              )}
              {link.icon === 'articles' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 4h9l3 3v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z"/><path d="M15 4v4h4M8 12h8M8 16h8"/></svg>
              )}
              {link.icon === 'projects' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="7" height="7" rx="1"/><rect x="14" y="4" width="7" height="7" rx="1"/><rect x="3" y="15" width="7" height="7" rx="1"/><rect x="14" y="15" width="7" height="7" rx="1"/></svg>
              )}
              {link.icon === 'settings' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2"/></svg>
              )}
              {link.icon === 'social' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M8 12a4 4 0 0 0 8 0"/></svg>
              )}
              {link.icon === 'profile' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M5 20a7 7 0 0 1 14 0"/></svg>
              )}
              {link.icon === 'deploy' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 4 9v12h16V9l-8-6Z"/><path d="M12 12v9"/></svg>
              )}
              {link.label}
            </a>
          ))}
        </>
      ))}
    </nav>

    <div class="adm-sidebar-foot">
      <a href="https://thabetrighi.com" class="adm-btn adm-btn--secondary adm-btn--sm" target="_blank" rel="noopener">{adminUi.nav.viewSite}</a>
      <button type="button" class="adm-btn adm-btn--secondary adm-btn--sm" id="admin-logout-btn">{adminUi.nav.logout}</button>
    </div>
  </aside>

  <div class="adm-main-col">
    <header class="adm-topbar">
      <div class="adm-topbar-start">
        <button type="button" class="adm-icon-btn" id="admin-menu-toggle" aria-label="القائمة">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
        <div>
          <div class="adm-page-title">{pageTitle}</div>
          <div class="adm-page-path">{adminUi.brand}</div>
        </div>
      </div>
      <div class="adm-topbar-end">
        <button type="button" class="adm-icon-btn" data-theme-toggle aria-label="تبديل الوضع">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
        </button>
      </div>
    </header>
    <main class="adm-page">
      <slot />
    </main>
  </div>
</div>

<div class="adm-overlay" id="admin-overlay"></div>

<script>
  import { initShell } from '../../lib/admin/ui/shell';
  initShell();
</script>
