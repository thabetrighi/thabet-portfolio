---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminShell from '../../../components/admin/AdminShell.astro';
import AdminPageConfig from '../../../components/admin/AdminPageConfig.astro';
import { adminUi } from '../../../lib/admin/ui/strings';
import { LOCALES } from '../../../lib/admin/config';

export const prerender = false;
const locale = Astro.url.searchParams.get('locale') || 'en';
---

<AdminLayout title={adminUi.nav.profile}>
  <AdminPageConfig config={{
    locale,
    successMsg: adminUi.common.success,
    errorMsg: adminUi.common.error,
    savingMsg: adminUi.common.saving,
    saveLabel: adminUi.common.save,
  }} />
  <AdminShell title={adminUi.nav.profile}>
    <div class="adm-page-header">
      <div>
        <h1 class="adm-h1">{adminUi.nav.profile}</h1>
        <p class="adm-lead">الخبرات، المهارات، النبذة والسيرة — محرر JSON مرئي</p>
      </div>
      <select class="adm-select" id="locale-select" style="width:110px;">
        {LOCALES.map((l) => <option value={l} selected={l === locale}>{l.toUpperCase()}</option>)}
      </select>
    </div>

    <form id="profile-form" class="adm-grid">
      <input type="hidden" id="sha" />

      <div class="adm-tabs" role="tablist">
        <button type="button" class="adm-tab is-active" data-tab="about">نبذة</button>
        <button type="button" class="adm-tab" data-tab="editor">محرر JSON</button>
      </div>

      <div class="adm-tab-panel" id="panel-about">
        <div class="adm-panel adm-panel-pad adm-grid">
          <div class="adm-field">
            <label class="adm-label">نبذة مختصرة</label>
            <textarea class="adm-textarea" id="aboutSummary" rows="3"></textarea>
          </div>
          <div class="adm-field">
            <label class="adm-label">نبذة موسعة</label>
            <textarea class="adm-textarea" id="aboutExtended" rows="6"></textarea>
          </div>
          <div class="adm-field">
            <label class="adm-label">ملف السيرة (Resume profile)</label>
            <textarea class="adm-textarea" id="resumeProfile" rows="4"></textarea>
          </div>
        </div>
      </div>

      <div class="adm-tab-panel hidden" id="panel-editor">
        <div class="adm-panel adm-panel-pad">
          <p class="adm-lead" style="margin-bottom:12px;">
            عدّل الخبرات والمهارات والشهادات بصرياً — بدون كتابة JSON يدوياً
          </p>
          <div id="profile-json-editor" class="adm-json-editor"></div>
        </div>
      </div>

      <div id="form-status" class="adm-alert hidden"></div>
      <div class="adm-btn-row">
        <button type="submit" class="adm-btn adm-btn--primary" id="save-btn">{adminUi.common.save}</button>
      </div>
    </form>
  </AdminShell>
</AdminLayout>

<script>
  import { initProfilePage } from '../../../lib/admin/ui/pages/profile';
  initProfilePage();
</script>
