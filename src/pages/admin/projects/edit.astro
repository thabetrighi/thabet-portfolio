---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminShell from '../../../components/admin/AdminShell.astro';
import { adminUi } from '../../../lib/admin/ui/strings';

export const prerender = false;
const locale = Astro.url.searchParams.get('locale') || 'en';
const slug = Astro.url.searchParams.get('slug') || '';
const isNew = Astro.url.searchParams.get('new') === '1';
---

<AdminLayout title={isNew ? 'مشروع جديد' : `تعديل: ${slug}`}>
  <AdminShell title={isNew ? 'مشروع جديد' : 'تعديل مشروع'}>
    <div class="adm-page-header">
      <div>
        <h1 class="adm-h1">{isNew ? 'مشروع جديد' : 'تعديل مشروع'}</h1>
        <p class="adm-lead">اللغة: {locale.toUpperCase()}</p>
      </div>
      <a href={`/admin/projects?locale=${locale}`} class="adm-btn adm-btn--secondary">{adminUi.common.cancel}</a>
    </div>

    <form id="project-form" class="adm-panel adm-panel-pad adm-grid">
      <input type="hidden" id="sha" name="sha" />

      <div class="adm-grid adm-grid-2">
        <div class="adm-field">
          <label class="adm-label" for="title">{adminUi.common.title}</label>
          <input class="adm-input" id="title" name="title" required />
        </div>
        <div class="adm-field">
          <label class="adm-label" for="slug">{adminUi.common.slug}</label>
          <input class="adm-input" id="slug" name="slug" required />
        </div>
      </div>

      <div class="adm-field">
        <label class="adm-label" for="excerpt">المقتطف</label>
        <textarea class="adm-textarea" id="excerpt" rows="2" required></textarea>
      </div>

      <div class="adm-field">
        <label class="adm-label" for="problem">المشكلة</label>
        <textarea class="adm-textarea" id="problem" rows="3" required></textarea>
      </div>

      <div class="adm-field">
        <label class="adm-label" for="solution">الحل</label>
        <textarea class="adm-textarea" id="solution" rows="3" required></textarea>
      </div>

      <div class="adm-grid adm-grid-2">
        <div class="adm-field">
          <label class="adm-label" for="role">الدور</label>
          <input class="adm-input" id="role" required />
        </div>
        <div class="adm-field">
          <label class="adm-label" for="result">النتيجة</label>
          <input class="adm-input" id="result" required />
        </div>
      </div>

      <div class="adm-grid adm-grid-3">
        <div class="adm-field">
          <label class="adm-label" for="technologies">التقنيات (فاصلة)</label>
          <input class="adm-input" id="technologies" required />
        </div>
        <div class="adm-field">
          <label class="adm-label" for="cover">صورة الغلاف</label>
          <input class="adm-input" id="cover" required />
        </div>
        <div class="adm-field">
          <label class="adm-label" for="order">الترتيب</label>
          <input class="adm-input" type="number" id="order" min="1" value="1" required />
        </div>
      </div>

      <div class="adm-grid adm-grid-2">
        <div class="adm-field">
          <label class="adm-label" for="github">GitHub (اختياري)</label>
          <input class="adm-input" id="github" type="url" />
        </div>
        <div class="adm-field">
          <label class="adm-label" for="demo">Demo (اختياري)</label>
          <input class="adm-input" id="demo" type="url" />
        </div>
      </div>

      <div class="adm-field">
        <label class="adm-label" for="body">المحتوى (Markdown)</label>
        <textarea class="adm-textarea adm-textarea--mono" id="body" rows="14" required></textarea>
      </div>

      <label class="adm-checkbox-row">
        <input type="checkbox" id="featured" checked />
        مميز
      </label>

      <div id="form-status" class="adm-alert hidden" role="alert"></div>

      <div class="adm-btn-row">
        <button type="submit" class="adm-btn adm-btn--primary" id="save-btn">{adminUi.common.save}</button>
        {!isNew && <button type="button" class="adm-btn adm-btn--danger" id="delete-btn">{adminUi.common.delete}</button>}
      </div>
    </form>
  </AdminShell>
</AdminLayout>

<script define:vars={{ locale, slug, isNew, saveLabel: adminUi.common.save, savingLabel: adminUi.common.saving, successMsg: adminUi.common.success, errorMsg: adminUi.common.error, confirmDelete: adminUi.common.confirmDelete }}>
  import { api } from '../../../lib/admin/ui/client';

  const form = document.getElementById('project-form');
  const status = document.getElementById('form-status');
  const saveBtn = document.getElementById('save-btn');
  const deleteBtn = document.getElementById('delete-btn');

  function showStatus(message, ok) {
    status.textContent = message;
    status.className = `adm-alert ${ok ? 'adm-alert--success' : 'adm-alert--error'}`;
    status.classList.remove('hidden');
  }

  async function loadProject() {
    if (isNew) return;
    const { data } = await api(`/api/admin/projects?locale=${locale}&slug=${slug}`);
    const { project } = data;
    if (!project) return;

    document.getElementById('sha').value = project.sha || '';
    document.getElementById('title').value = project.frontmatter.title || '';
    document.getElementById('slug').value = project.slug || '';
    document.getElementById('excerpt').value = project.frontmatter.excerpt || '';
    document.getElementById('problem').value = project.frontmatter.problem || '';
    document.getElementById('solution').value = project.frontmatter.solution || '';
    document.getElementById('role').value = project.frontmatter.role || '';
    document.getElementById('result').value = project.frontmatter.result || '';
    document.getElementById('technologies').value = (project.frontmatter.technologies || []).join(', ');
    document.getElementById('cover').value = project.frontmatter.cover || '';
    document.getElementById('order').value = project.frontmatter.order || 1;
    document.getElementById('github').value = project.frontmatter.github || '';
    document.getElementById('demo').value = project.frontmatter.demo || '';
    document.getElementById('body').value = project.body || '';
    document.getElementById('featured').checked = project.frontmatter.featured !== false;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    saveBtn.disabled = true;
    saveBtn.textContent = savingLabel;

    const payload = {
      locale,
      slug: document.getElementById('slug').value,
      sha: document.getElementById('sha').value || undefined,
      frontmatter: {
        title: document.getElementById('title').value,
        excerpt: document.getElementById('excerpt').value,
        problem: document.getElementById('problem').value,
        solution: document.getElementById('solution').value,
        role: document.getElementById('role').value,
        result: document.getElementById('result').value,
        technologies: document.getElementById('technologies').value.split(',').map((t) => t.trim()).filter(Boolean),
        cover: document.getElementById('cover').value,
        order: Number(document.getElementById('order').value),
        featured: document.getElementById('featured').checked,
        github: document.getElementById('github').value || undefined,
        demo: document.getElementById('demo').value || undefined,
      },
      body: document.getElementById('body').value,
    };

    try {
      const { res, data } = await api('/api/admin/projects', {
        method: 'POST',
        body: JSON.stringify(payload),
      });
      if (res.ok) {
        showStatus(successMsg, true);
        if (isNew) window.location.href = `/admin/projects/edit?locale=${locale}&slug=${data.slug}`;
      } else {
        showStatus(data.error || errorMsg, false);
      }
    } catch {
      showStatus(errorMsg, false);
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = saveLabel;
    }
  });

  deleteBtn?.addEventListener('click', async () => {
    if (!confirm(confirmDelete)) return;
    const sha = document.getElementById('sha').value;
    const { res } = await api(`/api/admin/projects/${slug}?locale=${locale}&sha=${sha}`, { method: 'DELETE' });
    if (res.ok) window.location.href = `/admin/projects?locale=${locale}`;
  });

  loadProject();
</script>
