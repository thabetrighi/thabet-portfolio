---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminShell from '../../../components/admin/AdminShell.astro';
import AdminPageConfig from '../../../components/admin/AdminPageConfig.astro';
import { adminUi } from '../../../lib/admin/ui/strings';

export const prerender = false;
const locale = Astro.url.searchParams.get('locale') || 'en';
const slug = Astro.url.searchParams.get('slug') || '';
const isNew = Astro.url.searchParams.get('new') === '1';
---

<AdminLayout title={isNew ? 'مشروع جديد' : `تعديل: ${slug}`}>
  <AdminPageConfig config={{
    locale,
    slug,
    isNew,
    saveLabel: adminUi.common.save,
    savingLabel: adminUi.common.saving,
    successMsg: adminUi.common.success,
    errorMsg: adminUi.common.error,
    confirmDelete: adminUi.common.confirmDelete,
  }} />
  <AdminShell title={isNew ? 'مشروع جديد' : 'تعديل مشروع'}>
    <div class="adm-page-header">
      <div>
        <h1 class="adm-h1">{isNew ? 'مشروع جديد' : 'تعديل مشروع'}</h1>
        <p class="adm-lead">اللغة: {locale.toUpperCase()}</p>
      </div>
      <a href={`/admin/projects?locale=${locale}`} class="adm-btn adm-btn--secondary">{adminUi.common.cancel}</a>
    </div>

    <form id="project-form" class="adm-panel adm-panel-pad adm-grid">
      <input type="hidden" id="sha" name="sha" />

      <div class="adm-grid adm-grid-2">
        <div class="adm-field">
          <label class="adm-label" for="title">{adminUi.common.title}</label>
          <input class="adm-input" id="title" name="title" required />
        </div>
        <div class="adm-field">
          <label class="adm-label" for="slug">{adminUi.common.slug}</label>
          <input class="adm-input" id="slug" name="slug" required />
        </div>
      </div>

      <div class="adm-field">
        <label class="adm-label" for="excerpt">المقتطف</label>
        <textarea class="adm-textarea" id="excerpt" rows="2" required></textarea>
      </div>

      <div class="adm-field">
        <label class="adm-label" for="problem">المشكلة</label>
        <textarea class="adm-textarea" id="problem" rows="3" required></textarea>
      </div>

      <div class="adm-field">
        <label class="adm-label" for="solution">الحل</label>
        <textarea class="adm-textarea" id="solution" rows="3" required></textarea>
      </div>

      <div class="adm-grid adm-grid-2">
        <div class="adm-field">
          <label class="adm-label" for="role">الدور</label>
          <input class="adm-input" id="role" required />
        </div>
        <div class="adm-field">
          <label class="adm-label" for="result">النتيجة</label>
          <input class="adm-input" id="result" required />
        </div>
      </div>

      <div class="adm-grid adm-grid-3">
        <div class="adm-field">
          <label class="adm-label" for="technologies">التقنيات (فاصلة)</label>
          <input class="adm-input" id="technologies" required />
        </div>
        <div class="adm-field">
          <label class="adm-label" for="cover">صورة الغلاف</label>
          <input class="adm-input" id="cover" required />
        </div>
        <div class="adm-field">
          <label class="adm-label" for="order">الترتيب</label>
          <input class="adm-input" type="number" id="order" min="1" value="1" required />
        </div>
      </div>

      <div class="adm-grid adm-grid-2">
        <div class="adm-field">
          <label class="adm-label" for="github">GitHub (اختياري)</label>
          <input class="adm-input" id="github" type="url" />
        </div>
        <div class="adm-field">
          <label class="adm-label" for="demo">Demo (اختياري)</label>
          <input class="adm-input" id="demo" type="url" />
        </div>
      </div>

      <div class="adm-field">
        <label class="adm-label" for="body">المحتوى (Markdown)</label>
        <textarea class="adm-textarea adm-textarea--mono" id="body" rows="14" required></textarea>
      </div>

      <label class="adm-checkbox-row">
        <input type="checkbox" id="featured" checked />
        مميز
      </label>

      <div id="form-status" class="adm-alert hidden" role="alert"></div>

      <div class="adm-btn-row">
        <button type="submit" class="adm-btn adm-btn--primary" id="save-btn">{adminUi.common.save}</button>
        {!isNew && <button type="button" class="adm-btn adm-btn--danger" id="delete-btn">{adminUi.common.delete}</button>}
      </div>
    </form>
  </AdminShell>
</AdminLayout>

<script>
  import { initProjectsEditPage } from '../../../lib/admin/ui/pages/projects-edit';
  initProjectsEditPage();
</script>
