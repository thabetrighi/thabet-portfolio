---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminShell from '../../../components/admin/AdminShell.astro';
import { adminUi } from '../../../lib/admin/ui/strings';
import { LOCALES } from '../../../lib/admin/config';

export const prerender = false;
const locale = Astro.url.searchParams.get('locale') || 'en';
---

<AdminLayout title={adminUi.nav.projects}>
  <AdminShell title={adminUi.nav.projects}>
    <div class="adm-page-header">
      <div>
        <h1 class="adm-h1">{adminUi.nav.projects}</h1>
        <p class="adm-lead">إدارة مشاريع Portfolio</p>
      </div>
      <div class="adm-btn-row">
        <select class="adm-select" id="locale-select" style="width:110px;">
          {LOCALES.map((l) => <option value={l} selected={l === locale}>{l.toUpperCase()}</option>)}
        </select>
        <a class="adm-btn adm-btn--primary" href={`/admin/projects/edit?locale=${locale}&new=1`}>{adminUi.common.create}</a>
      </div>
    </div>

    <div class="adm-panel">
      <div class="adm-toolbar">
        <input class="adm-input" id="search-input" type="search" placeholder={adminUi.common.search} style="max-width:280px;" />
        <span id="source-badge" class="adm-badge adm-badge--accent">...</span>
      </div>
      <div class="adm-table-wrap">
        <table class="adm-table">
          <thead>
            <tr>
              <th>{adminUi.common.title}</th>
              <th>{adminUi.common.slug}</th>
              <th>#</th>
              <th>{adminUi.common.actions}</th>
            </tr>
          </thead>
          <tbody id="projects-table">
            <tr><td colspan="4">{adminUi.common.loading}</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </AdminShell>
</AdminLayout>

<script define:vars={{ editLabel: adminUi.common.edit, noData: adminUi.common.noData, sourceGithub: adminUi.common.sourceGithub, sourceLocal: adminUi.common.sourceLocal }}>
  import { api, renderSkeletonRows } from '../../../lib/admin/ui/client';

  const select = document.getElementById('locale-select');
  const table = document.getElementById('projects-table');
  const search = document.getElementById('search-input');
  const sourceBadge = document.getElementById('source-badge');
  let allProjects = [];

  function renderProjects(items) {
    table.innerHTML = '';
    if (!items.length) {
      table.innerHTML = `<tr class="adm-table-empty"><td colspan="4">${noData}</td></tr>`;
      return;
    }
    for (const project of items) {
      const row = document.createElement('tr');
      row.innerHTML = `
        <td><strong>${project.title}</strong></td>
        <td><code>${project.slug}</code></td>
        <td>${project.order ?? '—'}</td>
        <td><a class="adm-btn adm-btn--secondary adm-btn--sm" href="/admin/projects/edit?locale=${select.value}&slug=${project.slug}">${editLabel}</a></td>
      `;
      table.appendChild(row);
    }
  }

  async function loadProjects() {
    renderSkeletonRows(table, 4);
    const { data } = await api(`/api/admin/projects?locale=${select.value}`);
    allProjects = data.projects || [];
    sourceBadge.textContent = data.source === 'github' ? sourceGithub : sourceLocal;
    sourceBadge.className = `adm-badge ${data.source === 'github' ? 'adm-badge--success' : 'adm-badge--warning'}`;
    renderProjects(allProjects);
  }

  search?.addEventListener('input', () => {
    const q = search.value.trim().toLowerCase();
    renderProjects(allProjects.filter((p) => p.title.toLowerCase().includes(q) || p.slug.toLowerCase().includes(q)));
  });

  select?.addEventListener('change', () => {
    window.location.href = `/admin/projects?locale=${select.value}`;
  });

  loadProjects().catch(() => {
    table.innerHTML = '<tr class="adm-table-empty"><td colspan="4">تعذّر تحميل المشاريع</td></tr>';
  });
</script>
