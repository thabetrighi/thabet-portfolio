---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { adminUi } from '../../lib/admin/ui/strings';
import { site } from '../../lib/site';

export const prerender = false;
---

<AdminLayout title={adminUi.login.title}>
  <div class="adm-auth">
    <div class="adm-auth-wrap">
      <div class="adm-auth-brand">
        <div class="adm-auth-brand-icon">T</div>
        <h1>{adminUi.brand}</h1>
        <p>{adminUi.login.subtitle}</p>
      </div>

      <div class="adm-auth-card">
        <h2>{adminUi.login.title}</h2>
        <p class="adm-auth-hint">أدخل بيانات الدخول للوصول إلى لوحة التحكم</p>

        <form id="admin-login-form" class="adm-grid">
          <div class="adm-field">
            <label class="adm-label" for="email">{adminUi.login.email}</label>
            <input
              class="adm-input"
              type="email"
              id="email"
              name="email"
              value={site.email}
              required
              autocomplete="email"
              placeholder="contact@thabetrighi.com"
            />
          </div>
          <div class="adm-field">
            <label class="adm-label" for="password">{adminUi.login.password}</label>
            <input
              class="adm-input"
              type="password"
              id="password"
              name="password"
              required
              autocomplete="current-password"
              placeholder="••••••••"
            />
          </div>
          <div class="cf-turnstile" data-sitekey={site.turnstileSiteKey}></div>
          <div id="login-status" class="adm-alert adm-alert--error hidden" role="alert"></div>
          <button type="submit" class="adm-btn adm-btn--primary" id="login-submit" style="width:100%;">
            {adminUi.login.submit}
          </button>
        </form>
      </div>

      <div class="adm-auth-foot">
        <a href="https://thabetrighi.com" target="_blank" rel="noopener">← العودة إلى الموقع</a>
      </div>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ errorMsg: adminUi.login.error, submitLabel: adminUi.login.submit }}>
  import { api } from '../../lib/admin/ui/client';

  api('/api/admin/auth/me').then(({ data }) => {
    if (data.authenticated) window.location.href = '/admin';
  }).catch(() => {});

  const form = document.getElementById('admin-login-form');
  const status = document.getElementById('login-status');
  const submit = document.getElementById('login-submit');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    status?.classList.add('hidden');
    if (submit) {
      submit.disabled = true;
      submit.textContent = 'جارٍ التحقق...';
    }

    try {
      const { res } = await api('/api/admin/auth/login', {
        method: 'POST',
        body: JSON.stringify({
          email: document.getElementById('email').value,
          password: document.getElementById('password').value,
          'cf-turnstile-response': form.querySelector('[name="cf-turnstile-response"]')?.value,
        }),
      });

      if (res.ok) {
        window.location.href = '/admin';
        return;
      }

      if (status) {
        status.textContent = errorMsg;
        status.classList.remove('hidden');
      }
      if (window.turnstile) window.turnstile.reset();
    } finally {
      if (submit) {
        submit.disabled = false;
        submit.textContent = submitLabel;
      }
    }
  });
</script>
