---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { adminUi } from '../../lib/admin/ui/strings';
import { site } from '../../lib/site';

export const prerender = false;
---

<AdminLayout title={adminUi.login.title}>
  <div class="admin-login">
    <div class="admin-login-card">
      <h1 class="admin-title">{adminUi.login.title}</h1>
      <p class="admin-subtitle">{adminUi.login.subtitle}</p>
      <form id="admin-login-form" class="admin-grid" style="margin-top: 1.5rem;">
        <div class="admin-field">
          <label class="admin-label" for="password">{adminUi.login.password}</label>
          <input class="admin-input" type="password" id="password" name="password" required autocomplete="current-password" />
        </div>
        <div class="cf-turnstile" data-sitekey={site.turnstileSiteKey}></div>
        <div id="login-status" class="admin-alert admin-alert-error hidden"></div>
        <button type="submit" class="admin-btn admin-btn-primary" id="login-submit">{adminUi.login.submit}</button>
      </form>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ errorMsg: adminUi.login.error }}>
  fetch('/api/admin/auth/me')
    .then((r) => r.json())
    .then((data) => {
      if (data.authenticated) window.location.href = '/admin';
    });

  const form = document.getElementById('admin-login-form');
  const status = document.getElementById('login-status');
  const submit = document.getElementById('login-submit');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    status?.classList.add('hidden');
    if (submit) submit.disabled = true;

    const password = (document.getElementById('password')).value;
    const turnstile = form.querySelector('[name="cf-turnstile-response"]')?.value;

    try {
      const res = await fetch('/api/admin/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password, 'cf-turnstile-response': turnstile }),
      });

      if (res.ok) {
        window.location.href = '/admin';
        return;
      }

      if (status) {
        status.textContent = errorMsg;
        status.classList.remove('hidden');
      }
      if (window.turnstile) window.turnstile.reset();
    } finally {
      if (submit) submit.disabled = false;
    }
  });
</script>

<style>
  .hidden { display: none; }
</style>
