---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { adminUi } from '../../lib/admin/ui/strings';
import { site } from '../../lib/site';

export const prerender = false;

// Strip credentials accidentally submitted via GET (never expose secrets in URL)
if (Astro.request.method === 'GET') {
  const params = Astro.url.searchParams;
  if (params.has('password') || params.has('cf-turnstile-response')) {
    return Astro.redirect('/admin/login?error=bad_request');
  }
}

const errorCode = Astro.url.searchParams.get('error');
const errorMessage = errorCode
  ? (adminUi.login.errors[errorCode as keyof typeof adminUi.login.errors] ?? adminUi.login.error)
  : null;
---

<AdminLayout title={adminUi.login.title}>
  <div class="adm-auth">
    <div class="adm-auth-wrap">
      <div class="adm-auth-brand">
        <div class="adm-auth-brand-icon">T</div>
        <h1>{adminUi.brand}</h1>
        <p>{adminUi.login.subtitle}</p>
      </div>

      <div class="adm-auth-card">
        <h2>{adminUi.login.title}</h2>
        <p class="adm-auth-hint">أدخل بيانات الدخول للوصول إلى لوحة التحكم</p>

        <form
          id="admin-login-form"
          class="adm-grid"
          method="post"
          action="/api/admin/auth/login"
          accept-charset="UTF-8"
        >
          <input type="hidden" name="redirect" value="1" />
          <div class="adm-field">
            <label class="adm-label" for="email">{adminUi.login.email}</label>
            <input
              class="adm-input"
              type="email"
              id="email"
              name="email"
              value={site.email}
              required
              autocomplete="email"
              placeholder="contact@thabetrighi.com"
            />
          </div>
          <div class="adm-field">
            <label class="adm-label" for="password">{adminUi.login.password}</label>
            <input
              class="adm-input"
              type="password"
              id="password"
              name="password"
              required
              autocomplete="current-password"
              placeholder="••••••••"
            />
          </div>
          <div class="cf-turnstile" data-sitekey={site.turnstileSiteKey}></div>
          {errorMessage && (
            <div id="login-status" class="adm-alert adm-alert--error" role="alert">
              {errorMessage}
            </div>
          )}
          {!errorMessage && (
            <div id="login-status" class="adm-alert adm-alert--error hidden" role="alert"></div>
          )}
          <button type="submit" class="adm-btn adm-btn--primary" id="login-submit" style="width:100%;">
            {adminUi.login.submit}
          </button>
        </form>
      </div>

      <div class="adm-auth-foot">
        <a href="https://thabetrighi.com" target="_blank" rel="noopener">← العودة إلى الموقع</a>
      </div>
    </div>
  </div>
</AdminLayout>

<script is:inline>
  fetch('/api/admin/auth/me', { credentials: 'same-origin' })
    .then((r) => r.json())
    .then((d) => { if (d.authenticated) window.location.href = '/admin'; })
    .catch(() => {});
</script>
