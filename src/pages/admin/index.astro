---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminShell from '../../components/admin/AdminShell.astro';
import AdminPageConfig from '../../components/admin/AdminPageConfig.astro';
import { adminUi } from '../../lib/admin/ui/strings';

export const prerender = false;
---

<AdminLayout title={adminUi.dashboard.title}>
  <AdminPageConfig config={{
    connected: adminUi.dashboard.githubConnected,
    disconnected: adminUi.dashboard.githubDisconnected,
    lastDeploy: adminUi.dashboard.lastDeploy,
  }} />
  <AdminShell title={adminUi.dashboard.title} hideTitle>
    <div class="adm-dashboard">
      <header class="adm-dashboard-header">
        <div class="adm-dashboard-intro">
          <p class="adm-dashboard-eyebrow">{adminUi.brand}</p>
          <h1 class="adm-h1">{adminUi.dashboard.title}</h1>
          <p class="adm-lead">{adminUi.dashboard.subtitle}</p>
        </div>
        <a href="/admin/deploy" class="adm-btn adm-btn--primary adm-dashboard-deploy">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3 4 9v12h16V9l-8-6Z"/><path d="M12 12v9"/></svg>
          {adminUi.common.deploy}
        </a>
      </header>

      <section class="adm-dashboard-section" aria-label="إحصائيات المحتوى">
        <div class="adm-stat-grid">
          <article class="adm-stat-card">
            <div class="adm-stat-label">{adminUi.dashboard.totalArticles}</div>
            <div class="adm-stat-value" id="stat-articles">—</div>
            <div class="adm-stat-meta" id="stat-articles-meta">...</div>
          </article>
          <article class="adm-stat-card">
            <div class="adm-stat-label">{adminUi.dashboard.totalProjects}</div>
            <div class="adm-stat-value" id="stat-projects">—</div>
            <div class="adm-stat-meta" id="stat-projects-meta">...</div>
          </article>
          <article class="adm-stat-card">
            <div class="adm-stat-label">{adminUi.dashboard.locales}</div>
            <div class="adm-stat-value">3</div>
            <div class="adm-stat-meta">AR · EN · FR</div>
          </article>
          <article class="adm-stat-card">
            <div class="adm-stat-label">GitHub</div>
            <div class="adm-stat-value adm-stat-value--compact" id="stat-github">...</div>
            <div class="adm-stat-meta" id="stat-deploy">...</div>
          </article>
        </div>
      </section>

      <section class="adm-dashboard-section adm-panel adm-panel-pad">
        <h2 class="adm-section-title">{adminUi.dashboard.quickActions}</h2>
        <div class="adm-action-grid">
          <a href="/admin/articles" class="adm-action-card">
            <span class="adm-action-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 4h9l3 3v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z"/><path d="M15 4v4h4M8 12h8M8 16h8"/></svg>
            </span>
            <span class="adm-action-card__text">
              <strong>{adminUi.nav.articles}</strong>
              <span>إدارة مقالات المدونة</span>
            </span>
          </a>
          <a href="/admin/projects" class="adm-action-card">
            <span class="adm-action-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="7" height="7" rx="1"/><rect x="14" y="4" width="7" height="7" rx="1"/><rect x="3" y="15" width="7" height="7" rx="1"/><rect x="14" y="15" width="7" height="7" rx="1"/></svg>
            </span>
            <span class="adm-action-card__text">
              <strong>{adminUi.nav.projects}</strong>
              <span>إدارة المشاريع</span>
            </span>
          </a>
          <a href="/admin/settings/site" class="adm-action-card">
            <span class="adm-action-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2"/></svg>
            </span>
            <span class="adm-action-card__text">
              <strong>{adminUi.nav.site}</strong>
              <span>إعدادات الموقع</span>
            </span>
          </a>
        </div>
      </section>

      <section class="adm-dashboard-section adm-panel adm-panel-pad">
        <h2 class="adm-section-title">{adminUi.dashboard.systemStatus}</h2>
        <div class="adm-status-list">
          <div class="adm-status-item">
            <span class="adm-status-item__label">GitHub</span>
            <div class="adm-status-item__value" id="github-status">{adminUi.common.loading}</div>
          </div>
          <div class="adm-status-item">
            <span class="adm-status-item__label">{adminUi.dashboard.lastDeploy}</span>
            <div class="adm-status-item__value" id="deploy-status">—</div>
          </div>
        </div>
      </section>
    </div>
  </AdminShell>
</AdminLayout>

<script>
  import { initDashboardPage } from '../../lib/admin/ui/pages/dashboard';
  initDashboardPage();
</script>
