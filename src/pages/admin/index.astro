---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminShell from '../../components/admin/AdminShell.astro';
import AdminPageConfig from '../../components/admin/AdminPageConfig.astro';
import { adminUi } from '../../lib/admin/ui/strings';

export const prerender = false;
---

<AdminLayout title={adminUi.dashboard.title}>
  <AdminPageConfig config={{
    connected: adminUi.dashboard.githubConnected,
    disconnected: adminUi.dashboard.githubDisconnected,
    lastDeploy: adminUi.dashboard.lastDeploy,
  }} />
  <AdminShell title={adminUi.dashboard.title}>
    <div class="adm-page-header">
      <div>
        <h1 class="adm-h1">{adminUi.dashboard.title}</h1>
        <p class="adm-lead">{adminUi.dashboard.subtitle}</p>
      </div>
      <a href="/admin/deploy" class="adm-btn adm-btn--primary">{adminUi.common.deploy}</a>
    </div>

    <div class="adm-grid adm-grid-4">
      <div class="adm-panel adm-stat">
        <div class="adm-stat-label">{adminUi.dashboard.totalArticles}</div>
        <div class="adm-stat-value" id="stat-articles">—</div>
        <div class="adm-stat-meta" id="stat-articles-meta">...</div>
      </div>
      <div class="adm-panel adm-stat">
        <div class="adm-stat-label">{adminUi.dashboard.totalProjects}</div>
        <div class="adm-stat-value" id="stat-projects">—</div>
        <div class="adm-stat-meta" id="stat-projects-meta">...</div>
      </div>
      <div class="adm-panel adm-stat">
        <div class="adm-stat-label">{adminUi.dashboard.locales}</div>
        <div class="adm-stat-value">3</div>
        <div class="adm-stat-meta">AR · EN · FR</div>
      </div>
      <div class="adm-panel adm-stat">
        <div class="adm-stat-label">GitHub</div>
        <div class="adm-stat-value" style="font-size:16px;" id="stat-github">...</div>
        <div class="adm-stat-meta" id="stat-deploy">...</div>
      </div>
    </div>

    <div class="adm-panel adm-panel-pad" style="margin-top:16px;">
      <div class="adm-h1" style="font-size:14px;margin-bottom:12px;">{adminUi.dashboard.quickActions}</div>
      <div class="adm-grid adm-grid-3">
        <a href="/admin/articles" class="adm-panel adm-link-card">
          <strong>{adminUi.nav.articles}</strong>
          <span>إدارة مقالات المدونة</span>
        </a>
        <a href="/admin/projects" class="adm-panel adm-link-card">
          <strong>{adminUi.nav.projects}</strong>
          <span>إدارة المشاريع</span>
        </a>
        <a href="/admin/settings/site" class="adm-panel adm-link-card">
          <strong>{adminUi.nav.site}</strong>
          <span>إعدادات الموقع</span>
        </a>
      </div>
    </div>

    <div class="adm-panel adm-panel-pad" style="margin-top:16px;">
      <div class="adm-h1" style="font-size:14px;margin-bottom:8px;">{adminUi.dashboard.systemStatus}</div>
      <div id="github-status" class="adm-lead">{adminUi.common.loading}</div>
      <div id="deploy-status" class="adm-lead" style="margin-top:6px;"></div>
    </div>
  </AdminShell>
</AdminLayout>

<script>
  import { initDashboardPage } from '../../lib/admin/ui/pages/dashboard';
  initDashboardPage();
</script>
