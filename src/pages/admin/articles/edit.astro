---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminShell from '../../../components/admin/AdminShell.astro';
import AdminPageConfig from '../../../components/admin/AdminPageConfig.astro';
import { adminUi } from '../../../lib/admin/ui/strings';

export const prerender = false;
const locale = Astro.url.searchParams.get('locale') || 'en';
const slug = Astro.url.searchParams.get('slug') || '';
const isNew = Astro.url.searchParams.get('new') === '1';
---

<AdminLayout title={isNew ? 'مقال جديد' : `تعديل: ${slug}`}>
  <AdminPageConfig config={{
    locale,
    slug,
    isNew,
    saveLabel: adminUi.common.save,
    savingLabel: adminUi.common.saving,
    successMsg: adminUi.common.success,
    errorMsg: adminUi.common.error,
    confirmDelete: adminUi.common.confirmDelete,
  }} />
  <AdminShell title={isNew ? 'مقال جديد' : 'تعديل مقال'}>
    <div class="adm-page-header">
      <div>
        <h1 class="adm-h1">{isNew ? 'مقال جديد' : 'تعديل مقال'}</h1>
        <p class="adm-lead">اللغة: {locale.toUpperCase()}</p>
      </div>
      <a href={`/admin/articles?locale=${locale}`} class="adm-btn adm-btn--secondary">{adminUi.common.cancel}</a>
    </div>

    <form id="article-form" class="adm-panel adm-panel-pad adm-grid">
      <input type="hidden" id="sha" name="sha" />
      <input type="hidden" id="previousSlug" name="previousSlug" value={slug} />

      <div class="adm-grid adm-grid-2">
        <div class="adm-field">
          <label class="adm-label" for="title">{adminUi.common.title}</label>
          <input class="adm-input" id="title" name="title" required />
        </div>
        <div class="adm-field">
          <label class="adm-label" for="slug">{adminUi.common.slug}</label>
          <input class="adm-input" id="slug" name="slug" required />
        </div>
      </div>

      <div class="adm-field">
        <label class="adm-label" for="excerpt">المقتطف</label>
        <textarea class="adm-textarea" id="excerpt" name="excerpt" rows="2" required></textarea>
      </div>

      <div class="adm-grid adm-grid-3">
        <div class="adm-field">
          <label class="adm-label" for="category">التصنيف</label>
          <input class="adm-input" id="category" name="category" required />
        </div>
        <div class="adm-field">
          <label class="adm-label" for="publishedAt">تاريخ النشر</label>
          <input class="adm-input" type="date" id="publishedAt" name="publishedAt" required />
        </div>
        <div class="adm-field">
          <label class="adm-label" for="readingTime">وقت القراءة (دقائق)</label>
          <input class="adm-input" type="number" id="readingTime" name="readingTime" min="1" required />
        </div>
      </div>

      <div class="adm-grid adm-grid-2">
        <div class="adm-field">
          <label class="adm-label" for="tags">الوسوم (مفصولة بفاصلة)</label>
          <input class="adm-input" id="tags" name="tags" />
        </div>
        <div class="adm-field">
          <label class="adm-label" for="cover">صورة الغلاف</label>
          <input class="adm-input" id="cover" name="cover" placeholder="/images/articles/example.svg" />
        </div>
      </div>

      <div class="adm-field">
        <label class="adm-label" for="body">المحتوى (Markdown)</label>
        <textarea class="adm-textarea adm-textarea--mono" id="body" name="body" rows="16" required></textarea>
      </div>

      <label class="adm-checkbox-row">
        <input type="checkbox" id="draft" name="draft" />
        مسودة
      </label>

      <div id="form-status" class="adm-alert hidden" role="alert"></div>

      <div class="adm-btn-row">
        <button type="submit" class="adm-btn adm-btn--primary" id="save-btn">{adminUi.common.save}</button>
        {!isNew && <button type="button" class="adm-btn adm-btn--danger" id="delete-btn">{adminUi.common.delete}</button>}
      </div>
    </form>
  </AdminShell>
</AdminLayout>

<script>
  import { initArticlesEditPage } from '../../../lib/admin/ui/pages/articles-edit';
  initArticlesEditPage();
</script>
