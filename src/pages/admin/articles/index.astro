---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminShell from '../../../components/admin/AdminShell.astro';
import AdminPageConfig from '../../../components/admin/AdminPageConfig.astro';
import { adminUi } from '../../../lib/admin/ui/strings';
import { LOCALES } from '../../../lib/admin/config';

export const prerender = false;
const locale = Astro.url.searchParams.get('locale') || 'en';
---

<AdminLayout title={adminUi.nav.articles}>
  <AdminPageConfig config={{
    editLabel: adminUi.common.edit,
    noData: adminUi.common.noData,
    sourceGithub: adminUi.common.sourceGithub,
    sourceLocal: adminUi.common.sourceLocal,
  }} />
  <AdminShell title={adminUi.nav.articles}>
    <div class="adm-page-header">
      <div>
        <h1 class="adm-h1">{adminUi.nav.articles}</h1>
        <p class="adm-lead">إدارة مقالات المدونة</p>
      </div>
      <div class="adm-btn-row">
        <select class="adm-select" id="locale-select" style="width:110px;">
          {LOCALES.map((l) => <option value={l} selected={l === locale}>{l.toUpperCase()}</option>)}
        </select>
        <a class="adm-btn adm-btn--primary" href={`/admin/articles/edit?locale=${locale}&new=1`}>{adminUi.common.create}</a>
      </div>
    </div>

    <div class="adm-panel">
      <div class="adm-toolbar">
        <input class="adm-input adm-search" id="search-input" type="search" placeholder={adminUi.common.search} style="max-width:280px;" />
        <span id="source-badge" class="adm-badge adm-badge--accent">...</span>
      </div>
      <div class="adm-table-wrap">
        <table class="adm-table">
          <thead>
            <tr>
              <th>{adminUi.common.title}</th>
              <th>{adminUi.common.slug}</th>
              <th>{adminUi.common.category}</th>
              <th>{adminUi.common.date}</th>
              <th>{adminUi.common.actions}</th>
            </tr>
          </thead>
          <tbody id="articles-table">
            <tr><td colspan="5">{adminUi.common.loading}</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </AdminShell>
</AdminLayout>

<script>
  import { initArticlesIndexPage } from '../../../lib/admin/ui/pages/articles-index';
  initArticlesIndexPage();
</script>
