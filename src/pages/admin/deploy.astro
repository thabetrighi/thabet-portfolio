---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminShell from '../../components/admin/AdminShell.astro';
import AdminPageConfig from '../../components/admin/AdminPageConfig.astro';
import { adminUi } from '../../lib/admin/ui/strings';

export const prerender = false;
---

<AdminLayout title={adminUi.nav.deploy}>
  <AdminPageConfig config={{
    deployLabel: adminUi.common.deploy,
    deployingLabel: adminUi.common.deploying,
    successMsg: adminUi.common.success,
    errorMsg: adminUi.common.error,
  }} />
  <AdminShell title={adminUi.nav.deploy}>
    <div class="adm-page-header">
      <div>
        <h1 class="adm-h1">{adminUi.nav.deploy}</h1>
        <p class="adm-lead">تشغيل GitHub Actions لبناء ونشر الموقع</p>
      </div>
    </div>

    <div class="adm-panel adm-panel-pad adm-grid">
      <div id="deploy-info" class="adm-lead">{adminUi.common.loading}</div>
      <div class="adm-btn-row">
        <button type="button" class="adm-btn adm-btn--primary" id="deploy-btn">{adminUi.common.deploy}</button>
        <a class="adm-btn adm-btn--secondary" id="deploy-link" href="#" target="_blank" rel="noopener" style="display:none;">عرض في GitHub</a>
      </div>
      <div id="deploy-status" class="adm-alert hidden"></div>
    </div>

    <div class="adm-panel adm-panel-pad" style="margin-top:16px;">
      <div class="adm-h1" style="font-size:14px;margin-bottom:8px;">كيف يعمل النشر؟</div>
      <ol class="adm-lead" style="padding-inline-start:1.25rem;line-height:1.8;">
        <li>تحفظ التغييرات من اللوحة → commit على GitHub</li>
        <li>تضغط «نشر الآن» → يشغّل workflow</li>
        <li>GitHub Actions يبني الموقع وينشره على Cloudflare</li>
      </ol>
    </div>
  </AdminShell>
</AdminLayout>

<script>
  import { initDeployPage } from '../../lib/admin/ui/pages/deploy';
  initDeployPage();
</script>
