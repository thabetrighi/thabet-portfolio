---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminShell from '../../../components/admin/AdminShell.astro';
import AdminPageConfig from '../../../components/admin/AdminPageConfig.astro';
import { adminUi } from '../../../lib/admin/ui/strings';

export const prerender = false;
const platforms = ['github','gitlab','linkedin','facebook','x','instagram','youtube','stackoverflow','devto'];
---

<AdminLayout title={adminUi.nav.social}>
  <AdminPageConfig config={{
    platforms,
    successMsg: adminUi.common.success,
    errorMsg: adminUi.common.error,
  }} />
  <AdminShell title={adminUi.nav.social}>
    <div class="adm-page-header">
      <div>
        <h1 class="adm-h1">{adminUi.nav.social}</h1>
        <p class="adm-lead">روابط حساباتك على المنصات</p>
      </div>
    </div>

    <form id="social-form" class="adm-panel adm-panel-pad adm-grid">
      <input type="hidden" id="sha" />
      <div id="links-container" class="adm-grid adm-grid-2"></div>
      <div id="form-status" class="adm-alert hidden"></div>
      <button type="submit" class="adm-btn adm-btn--primary">{adminUi.common.save}</button>
    </form>
  </AdminShell>
</AdminLayout>

<script>
  import { initSocialSettingsPage } from '../../../lib/admin/ui/pages/social-settings';
  initSocialSettingsPage();
</script>
