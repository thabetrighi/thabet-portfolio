---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminShell from '../../../components/admin/AdminShell.astro';
import { adminUi } from '../../../lib/admin/ui/strings';

export const prerender = false;
---

<AdminLayout title={adminUi.nav.site}>
  <AdminShell title={adminUi.nav.site}>
    <div class="adm-page-header">
      <div>
        <h1 class="adm-h1">{adminUi.nav.site}</h1>
        <p class="adm-lead">الاسم، البريد، الروابط والشعار</p>
      </div>
      <span id="source-badge" class="adm-badge adm-badge--accent">...</span>
    </div>

    <form id="site-form" class="adm-panel adm-panel-pad adm-grid">
      <input type="hidden" id="sha" />
      <div class="adm-grid adm-grid-2">
        <div class="adm-field"><label class="adm-label">الاسم القصير</label><input class="adm-input" id="name" required /></div>
        <div class="adm-field"><label class="adm-label">البريد</label><input class="adm-input" id="email" type="email" required /></div>
      </div>
      <div class="adm-grid adm-grid-3">
        <div class="adm-field"><label class="adm-label">الاسم (عربي)</label><input class="adm-input" id="fullNameAr" required /></div>
        <div class="adm-field"><label class="adm-label">الاسم (English)</label><input class="adm-input" id="fullNameEn" required /></div>
        <div class="adm-field"><label class="adm-label">الاسم (Français)</label><input class="adm-input" id="fullNameFr" required /></div>
      </div>
      <div class="adm-grid adm-grid-2">
        <div class="adm-field"><label class="adm-label">رابط الموقع</label><input class="adm-input" id="url" type="url" required /></div>
        <div class="adm-field"><label class="adm-label">الشعار (مسار)</label><input class="adm-input" id="logo" placeholder="/images/logo.svg" /></div>
      </div>
      <div id="form-status" class="adm-alert hidden"></div>
      <div class="adm-btn-row">
        <button type="submit" class="adm-btn adm-btn--primary" id="save-btn">{adminUi.common.save}</button>
      </div>
    </form>
  </AdminShell>
</AdminLayout>

<script define:vars={{ successMsg: adminUi.common.success, errorMsg: adminUi.common.error, savingMsg: adminUi.common.saving, sourceGithub: adminUi.common.sourceGithub, sourceLocal: adminUi.common.sourceLocal }}>
  import { api, setStatus, showToast } from '../../../lib/admin/ui/client';

  const form = document.getElementById('site-form');
  const status = document.getElementById('form-status');
  const saveBtn = document.getElementById('save-btn');
  const sourceBadge = document.getElementById('source-badge');

  async function load() {
    const { data, res } = await api('/api/admin/settings/site');
    if (!res.ok || !data.data) {
      setStatus(status, errorMsg, 'error');
      return;
    }

    sourceBadge.textContent = data.source === 'github' ? sourceGithub : sourceLocal;
    sourceBadge.className = `adm-badge ${data.source === 'github' ? 'adm-badge--success' : 'adm-badge--warning'}`;

    document.getElementById('sha').value = data.sha || '';
    document.getElementById('name').value = data.data.name || '';
    document.getElementById('email').value = data.data.email || '';
    document.getElementById('url').value = data.data.url || '';
    document.getElementById('logo').value = data.data.logo || '';
    document.getElementById('fullNameAr').value = data.data.fullName?.ar || '';
    document.getElementById('fullNameEn').value = data.data.fullName?.en || '';
    document.getElementById('fullNameFr').value = data.data.fullName?.fr || '';
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    saveBtn.disabled = true;
    saveBtn.textContent = savingMsg;

    const payload = {
      sha: document.getElementById('sha').value || undefined,
      data: {
        name: document.getElementById('name').value,
        email: document.getElementById('email').value,
        url: document.getElementById('url').value,
        logo: document.getElementById('logo').value,
        fullName: {
          ar: document.getElementById('fullNameAr').value,
          en: document.getElementById('fullNameEn').value,
          fr: document.getElementById('fullNameFr').value,
        },
      },
    };

    try {
      const { res } = await api('/api/admin/settings/site', { method: 'PUT', body: JSON.stringify(payload) });
      if (res.ok) {
        showToast(successMsg, 'success');
        setStatus(status, successMsg, 'success');
        await load();
      } else {
        setStatus(status, errorMsg, 'error');
      }
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = 'حفظ التغييرات';
    }
  });

  load().catch(() => setStatus(status, errorMsg, 'error'));
</script>
