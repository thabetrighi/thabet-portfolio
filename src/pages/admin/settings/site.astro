---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminShell from '../../../components/admin/AdminShell.astro';
import { adminUi } from '../../../lib/admin/ui/strings';

export const prerender = false;
---

<AdminLayout title={adminUi.nav.site}>
  <AdminShell title={adminUi.nav.site}>
    <div class="admin-header">
      <div>
        <h1 class="admin-title">{adminUi.nav.site}</h1>
        <p class="admin-subtitle">الاسم، البريد، الروابط والشعار</p>
      </div>
      <span id="source-badge" class="admin-badge admin-badge-muted">...</span>
    </div>

    <form id="site-form" class="admin-card admin-grid">
      <input type="hidden" id="sha" />
      <div class="admin-grid admin-grid-2">
        <div class="admin-field"><label class="admin-label">الاسم القصير</label><input class="admin-input" id="name" required /></div>
        <div class="admin-field"><label class="admin-label">البريد</label><input class="admin-input" id="email" type="email" required /></div>
      </div>
      <div class="admin-grid admin-grid-3">
        <div class="admin-field"><label class="admin-label">الاسم (عربي)</label><input class="admin-input" id="fullNameAr" required /></div>
        <div class="admin-field"><label class="admin-label">الاسم (English)</label><input class="admin-input" id="fullNameEn" required /></div>
        <div class="admin-field"><label class="admin-label">الاسم (Français)</label><input class="admin-input" id="fullNameFr" required /></div>
      </div>
      <div class="admin-grid admin-grid-2">
        <div class="admin-field"><label class="admin-label">رابط الموقع</label><input class="admin-input" id="url" type="url" required /></div>
        <div class="admin-field"><label class="admin-label">الشعار (مسار)</label><input class="admin-input" id="logo" placeholder="/images/logo.svg" /></div>
      </div>
      <div id="form-status" class="admin-alert hidden"></div>
      <div class="admin-actions">
        <button type="submit" class="admin-btn admin-btn-primary" id="save-btn">{adminUi.common.save}</button>
      </div>
    </form>
  </AdminShell>
</AdminLayout>

<script define:vars={{ successMsg: adminUi.common.success, errorMsg: adminUi.common.error, savingMsg: adminUi.common.saving, sourceGithub: adminUi.common.sourceGithub, sourceLocal: adminUi.common.sourceLocal }}>
  const form = document.getElementById('site-form');
  const status = document.getElementById('form-status');
  const saveBtn = document.getElementById('save-btn');
  const sourceBadge = document.getElementById('source-badge');

  async function load() {
    try {
      const { data, res } = await window.AdminUI.api('/api/admin/settings/site');
      if (!res.ok || !data.data) {
        window.AdminUI.setStatus(status, errorMsg, 'error');
        return;
      }

      sourceBadge.textContent = data.source === 'github' ? sourceGithub : sourceLocal;
      sourceBadge.className = `admin-badge ${data.source === 'github' ? 'admin-badge-success' : 'admin-badge-warning'}`;

      document.getElementById('sha').value = data.sha || '';
      document.getElementById('name').value = data.data.name || '';
      document.getElementById('email').value = data.data.email || '';
      document.getElementById('url').value = data.data.url || '';
      document.getElementById('logo').value = data.data.logo || '';
      document.getElementById('fullNameAr').value = data.data.fullName?.ar || '';
      document.getElementById('fullNameEn').value = data.data.fullName?.en || '';
      document.getElementById('fullNameFr').value = data.data.fullName?.fr || '';
    } catch {
      window.AdminUI.setStatus(status, errorMsg, 'error');
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    saveBtn.disabled = true;
    saveBtn.textContent = savingMsg;

    const payload = {
      sha: document.getElementById('sha').value || undefined,
      data: {
        name: document.getElementById('name').value,
        email: document.getElementById('email').value,
        url: document.getElementById('url').value,
        logo: document.getElementById('logo').value,
        fullName: {
          ar: document.getElementById('fullNameAr').value,
          en: document.getElementById('fullNameEn').value,
          fr: document.getElementById('fullNameFr').value,
        },
      },
    };

    try {
      const { res } = await window.AdminUI.api('/api/admin/settings/site', {
        method: 'PUT',
        body: JSON.stringify(payload),
      });
      if (res.ok) {
        window.AdminUI.showToast(successMsg, 'success');
        window.AdminUI.setStatus(status, successMsg, 'success');
        await load();
      } else {
        window.AdminUI.setStatus(status, errorMsg, 'error');
      }
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = 'حفظ التغييرات';
    }
  });

  load();
</script>
