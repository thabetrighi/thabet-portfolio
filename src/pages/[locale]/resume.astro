---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Experience from '../../components/sections/Experience.astro';
import { useTranslations } from '../../i18n/ui';
import { getResume, getSkills } from '../../lib/content';
import type { Locale } from '../../i18n/config';

export const prerender = true;

export async function getStaticPaths() {
  const locales: Locale[] = ['ar', 'en', 'fr'];
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
const resume = getResume(locale);
const skills = getSkills(locale);
const cvFile = resume.cvFiles[locale] || resume.cvFiles.en;
---

<BaseLayout
  title={t.resume.title}
  description={resume.profile}
  locale={locale}
>
  <Header slot="header" locale={locale} currentPath="resume" />
  <div class="mx-auto max-w-wide px-5 py-16 md:px-8 md:py-24">
    <header class="mb-12 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="section-label mb-4">04</p>
        <h1 class="font-display text-4xl tracking-tight md:text-5xl">{t.resume.title}</h1>
      </div>
      {cvFile && (
        <a href={cvFile} class="btn btn-primary no-underline" download>
          {t.resume.download}
        </a>
      )}
    </header>

    <section class="mb-16 max-w-2xl">
      <h2 class="section-label mb-4">{t.resume.profile}</h2>
      <p class="text-lg leading-relaxed text-ink-secondary dark:text-ink-secondary-dark">{resume.profile}</p>
    </section>

    <section class="mb-16">
      <h2 class="section-label mb-8">{t.resume.education}</h2>
      {resume.education.map((edu) => (
        <div class="border-s border-border ps-6 dark:border-border-dark">
          <h3 class="font-display text-xl">{edu.institution}</h3>
          <p class="mt-1 text-sm text-accent dark:text-accent-dark">{edu.degree}</p>
          <p class="mt-1 font-mono text-xs text-ink-muted dark:text-ink-muted-dark">{edu.period} · {edu.location}</p>
        </div>
      ))}
    </section>

    <section class="mb-16">
      <h2 class="section-label mb-8">{t.resume.certifications}</h2>
      <ul class="space-y-4">
        {resume.certifications.map((cert) => (
          <li class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-4">
            <span class="font-medium">{cert.name}</span>
            <span class="text-sm text-ink-muted dark:text-ink-muted-dark">{cert.issuer} · {cert.year}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="mb-16">
      <h2 class="section-label mb-8">{t.resume.languages}</h2>
      <ul class="grid gap-4 sm:grid-cols-3">
        {resume.languages.map((lang) => (
          <li>
            <span class="font-medium">{lang.language}</span>
            <span class="block text-sm text-ink-muted dark:text-ink-muted-dark">{lang.level}</span>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="section-label mb-8">{t.skills.title}</h2>
      <div class="grid gap-8 sm:grid-cols-2">
        {skills.map((area) => (
          <div>
            <h3 class="mb-3 font-mono text-xs uppercase tracking-wider">{area.name}</h3>
            <p class="text-sm text-ink-secondary dark:text-ink-secondary-dark">{area.items.join(' · ')}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
  <Experience locale={locale} />
  <Footer slot="footer" locale={locale} />
</BaseLayout>
