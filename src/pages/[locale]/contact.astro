---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import ContactForm from '../../components/ContactForm.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import { useTranslations } from '../../i18n/ui';
import { site } from '../../lib/site';
import type { Locale } from '../../i18n/config';

export const prerender = true;

export async function getStaticPaths() {
  const locales: Locale[] = ['ar', 'en', 'fr'];
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
---

<BaseLayout
  title={t.contact.title}
  description={t.contact.subtitle}
  locale={locale}
>
  <Header slot="header" locale={locale} currentPath="contact" />
  <div class="mx-auto max-w-wide px-5 py-16 md:px-8 md:py-24">
    <div class="grid gap-16 lg:grid-cols-2">
      <div>
        <p class="section-label mb-4">05</p>
        <h1 class="font-display text-4xl tracking-tight md:text-5xl">{t.contact.title}</h1>
        <p class="mt-6 text-lg text-ink-secondary dark:text-ink-secondary-dark">{t.contact.subtitle}</p>

        <div class="mt-10 space-y-6">
          <a
            href={`mailto:${site.email}`}
            class="inline-flex items-center gap-2 text-lg text-ink link-underline dark:text-ink-dark no-underline"
          >
            <svg class="h-5 w-5 text-accent dark:text-accent-dark" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
            </svg>
            {site.email}
          </a>

          <div>
            <p class="section-label mb-3">{t.contact.social}</p>
            <SocialLinks size="lg" />
          </div>
        </div>
      </div>

      <div>
        <ContactForm locale={locale} />
      </div>
    </div>
  </div>
  <Footer slot="footer" locale={locale} />
</BaseLayout>
